rules_version = '2';

// PHASE 5 RULES — market data + auth-based ownership + chat/offers + orders.
// Admin custom claims (feature #36) still don't exist — a later phase.
//
// The `orders` section below is the most important one to read carefully
// if you're extending this app: it deliberately blocks the client from
// writing anything except the INITIAL pendingPayment record and a
// pendingPayment→cancelled transition. Every other status change (paid,
// shipped, delivered, refunded) is only trustworthy coming from a Cloud
// Function using the Admin SDK (which bypasses these rules entirely) —
// see functions/index.js and lib/services/order_repository.dart for the
// full explanation of why.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(sellerId) {
      return isSignedIn() && request.auth.uid == sellerId;
    }

    function isParticipant(doc) {
      return isSignedIn() &&
        (request.auth.uid == doc.data.buyerId || request.auth.uid == doc.data.sellerId);
    }

    match /products/{productId} {
      // Anyone can browse the market — signed in or not.
      allow read: if true;

      // Any signed-in trader can list a new product, as long as the
      // listing is attached to their OWN uid (not someone else's).
      allow create: if isSignedIn()
                    && request.resource.data.sellerId == request.auth.uid;

      // Only the trader who owns a listing can edit or remove it — until
      // admin claims exist, there's no "admin override" here.
      allow update, delete: if isOwner(resource.data.sellerId);
    }

    match /conversations/{conversationId} {
      // Only the buyer and seller in a conversation can see it — this is
      // a private deal thread, not public like the market listings.
      allow read: if isParticipant(resource);

      // A conversation can only be created by the buyer named in it, and
      // it has to be a real buyer/seller pair (not someone messaging
      // themselves).
      allow create: if isSignedIn()
                    && request.resource.data.buyerId == request.auth.uid
                    && request.resource.data.buyerId != request.resource.data.sellerId;

      // Either side can update metadata (lastMessage, lastMessageAt, their
      // own lastReadAt) — but only THEIR OWN read-receipt field, never the
      // other participant's.
      allow update: if isParticipant(resource) &&
                    !request.resource.data.diff(resource.data).affectedKeys()
                      .hasAny(['buyerId', 'sellerId', 'productId']) &&
                    (
                      request.auth.uid == resource.data.buyerId
                        ? !request.resource.data.diff(resource.data).affectedKeys().hasAny(['sellerLastReadAt'])
                        : !request.resource.data.diff(resource.data).affectedKeys().hasAny(['buyerLastReadAt'])
                    );

      allow delete: if false; // no delete flow yet — nothing should need this

      match /messages/{messageId} {
        // A message is readable/writable by conversation participants only.
        // senderId on a NEW message must match whoever's actually signed in
        // — stops one participant from writing messages "as" the other.
        allow read: if isParticipant(get(/databases/$(database)/documents/conversations/$(conversationId)));
        allow create: if isParticipant(get(/databases/$(database)/documents/conversations/$(conversationId)))
                      && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false; // messages are immutable once sent
      }
    }

    match /orders/{orderId} {
      // Only the buyer and seller in the deal can see their own order —
      // financial records are private, unlike public product listings.
      allow read: if isParticipant(resource);

      // Client may create an order ONLY as pendingPayment, ONLY as the
      // named buyer, and ONLY for themselves (can't fabricate an order
      // "paid" from the start, can't create one on someone else's behalf).
      // No money has moved at this point — this is intent, not payment.
      allow create: if isSignedIn()
                    && request.resource.data.buyerId == request.auth.uid
                    && request.resource.data.buyerId != request.resource.data.sellerId
                    && request.resource.data.status == 'pendingPayment';

      // The ONLY client-writable status transition: the buyer cancelling
      // their own order WHILE it's still pendingPayment (nothing charged
      // yet, so nothing to protect). Every other transition — paid,
      // shipped, delivered, refunded — is rejected here on purpose; those
      // only happen via a Cloud Function using the Admin SDK, which does
      // not go through these rules at all.
      allow update: if isSignedIn()
                    && request.auth.uid == resource.data.buyerId
                    && resource.data.status == 'pendingPayment'
                    && request.resource.data.status == 'cancelled'
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);

      allow delete: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

// ---------------------------------------------------------------------
// TODO (once the admin dashboard assigns custom claims):
//
// function isAdmin() {
//   return isSignedIn() && request.auth.token.admin == true;
// }
//
// - products: allow update/delete for isAdmin() too (feature #36 — admin
//   price overrides; consider isolating the `price` field specifically).
// - conversations: allow an admin to read any conversation for the
//   disputes center (feature #24, "مركز النزاعات").
// - orders: allow an admin to READ any order for the disputes center;
//   admin-triggered refunds should still go through a Cloud Function
//   (never a direct client write to `status`), so the money-moving side
//   stays server-verified even for admin actions.
// ---------------------------------------------------------------------
